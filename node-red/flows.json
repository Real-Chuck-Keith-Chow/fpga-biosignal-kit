[
  {
    "id": "mqtt_in",
    "type": "mqtt in",
    "z": "flow1",
    "name": "FPGA Signal",
    "topic": "factory/signal",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker",
    "x": 140,
    "y": 100,
    "wires": [["chart", "fault_check"]]
  },
  {
    "id": "chart",
    "type": "ui_chart",
    "z": "flow1",
    "name": "Signal Chart",
    "group": "ui_group",
    "order": 1,
    "width": 12,
    "height": 6,
    "label": "Live Biosignal",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Waiting for data...",
    "removeOlder": "60",
    "removeOlderUnit": "60",
    "useUTC": false,
    "x": 420,
    "y": 60,
    "wires": [[], []]
  },
  {
    "id": "fault_check",
    "type": "function",
    "z": "flow1",
    "name": "Fault Detection",
    "func": "if (msg.payload.fault) {\n    msg.payload = 'FAULT DETECTED';\n} else {\n    msg.payload = 'NORMAL';\n}\nreturn msg;",
    "outputs": 1,
    "x": 430,
    "y": 140,
    "wires": [["status_text"]]
  },
  {
    "id": "status_text",
    "type": "ui_text",
    "z": "flow1",
    "group": "ui_group",
    "order": 2,
    "width": 6,
    "height": 1,
    "name": "System Status",
    "label": "Status",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 700,
    "y": 140,
    "wires": []
  },
  {
    "id": "mqtt_broker",
    "type": "mqtt-broker",
    "name": "Local MQTT",
    "broker": "localhost",
    "port": "1883"
  },
  {
    "id": "ui_group",
    "type": "ui_group",
    "name": "FPGA Dashboard",
    "tab": "ui_tab",
    "order": 1,
    "width": "12"
  },
  {
    "id": "ui_tab",
    "type": "ui_tab",
    "name": "FPGA Monitor",
    "icon": "dashboard",
    "order": 1
  }
]
